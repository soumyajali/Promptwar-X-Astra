# CivicPulse AI — optional settings. Nothing here is secret and no API keys are required.
CIVICPULSE_AUTHORITY_CODE=civic-demo         # legacy shared header for API scripts/tests (staff sign in with accounts)
# CIVICPULSE_SESSION_HOURS=12                # how long a sign-in lasts
CIVICPULSE_AUTO_SEED=1                       # seed 46 demo reports when the database is empty
CIVICPULSE_MAX_IMAGE_MB=5                    # photo upload limit
CIVICPULSE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CIVICPULSE_DATA_DIR=./data                 # where civicpulse.db and uploads/ are stored
CIVICPULSE_TZ_OFFSET_MIN=330                 # local time offset for "today" in assistant answers
# Optional: lets a language model phrase assistant answers. Without it the local engine answers everything.
# ANTHROPIC_API_KEY=
# CIVICPULSE_LLM_MODEL=claude-haiku-5-5
# CIVICPULSE_LLM_API_VERSION=2023-06-01
